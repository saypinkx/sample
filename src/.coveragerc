[run]
source = components
omit =
    */tests/*
    */__pycache__/*
    */.venv/*
    */venv/*
    */__init__.py
    */application/*
    */infra/*
    */scopes/*

[report]
include =
    */domain/*

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
